menu "ToDoHelper: system utilities"

    config TODOHELPER_LOG_LEVEL
        int "Default ToDoHelper log level (0=ERR 1=WARN 2=INFO 3=DEBUG)"
        range 0 3
        default 2
        help
            Compile-time default for sys_log_set_level(). It can still be changed
            at runtime by calling sys_log_set_level().

    config TODOHELPER_NVS_NAMESPACE
        string "NVS namespace used by sys_config_*"
        default "todohelper"
        help
            All components must store configuration through sys_config_* which
            uses this namespace. Key names are registered in docs/API.md.

    config TODOHELPER_EVENT_QUEUE_SIZE
        int "Shared event loop queue size"
        range 8 128
        default 32

    config TODOHELPER_EVENT_TASK_STACK
        int "Shared event loop task stack size"
        default 4096

    config TODOHELPER_EVENT_TASK_PRIO
        int "Shared event loop task priority"
        default 5

endmenu
