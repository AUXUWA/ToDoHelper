# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.1.0 Project Minimal Configuration
#
# default:
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=12768

# The shared system event task handles WiFi/IP events, and the IDF WiFi logging
# path is stack hungry (wifi_log -> esp_log_write_wrapper -> log mutex). The
# default ~2.8 KB overflowed once already (see AGENT.md 9.0.1); the real fix was
# moving work out of the handler, and this is the belt to that pair of braces.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# THE critical knob on this board.
#
# Internal RAM is ~310 KB total, PSRAM is 12.4 MB. The IDF default of 16384 makes
# every allocation below 16 KB prefer internal RAM, and esp_wifi_init() makes a
# *lot* of those, which defeats SPIRAM_TRY_ALLOCATE_WIFI_LWIP. Measured on the
# device: with 16384, WiFi dropped internal free from 172 KB to 15 KB with a
# largest free block of 0 KB, so SDMMC DMA, httpd, the AI worker and I2S then all
# failed with "not enough mem" / ESP_ERR_NO_MEM.
#
# Keeping the threshold at 4 KB sends the generic mid-size allocations to PSRAM
# and leaves internal RAM available for the allocations that genuinely require it
# (MALLOC_CAP_DMA descriptors, task stacks, net80211's large blocks).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
# WiFi 静态收发缓冲：16 → 10（IDF 在不用 PSRAM-for-WiFi 时的默认值）。
#
# esp32s31 的 WiFi 适配层把静态队列存储和所有 DMA 缓冲**硬钉在内部 RAM**
# （IDF components/esp_wifi/esp32s31/esp_adapter.c），所以
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP 在这些缓冲上完全无效。
# 每个缓冲约 1.6 KB（IDF components/esp_wifi/Kconfig），16 → 10 就是
# 2 × 6 × 1.6 KB ≈ **19 KB 内部 DRAM**。
#
# 为什么重要：内部堆的最大连续块是 WiFi PHY 重新使能的硬需求（约 30 KB，
# 见 AGENT.md 9.0.3），拿不到就 abort 重启。v1.7.0 上机实测：地址刚到时
# 天气 / 墨墨 / 云端队列三个 TLS 握手并发，内部连续块不够，mbedTLS 报
# -0x008D（PSA_ERROR_INSUFFICIENT_MEMORY）。把这 19 KB 拿回来正是解药。
#
# 约束：RX_BA_WIN=16 ≤ STATIC_RX_BUFFER_NUM << 1 = 20，IDF 的检查仍满足。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=10
CONFIG_FREERTOS_HZ=1000
# Lets the components that support it place their worker task stacks in PSRAM.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# mDNS must not take internal RAM. Its task stack and its internal allocation
# both default to internal RAM, and both failed outright on this board
# ("failed to allocate memory for the mDNS task's stack", free heap 10 MB).
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# ToDoHelper: app_main does module orchestration, and page objects are created
# from it (ui_page_switch -> page create) while FreeType fonts are in play.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# ToDoHelper: file names under <root>/todohelper/... need long filename support.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# ToDoHelper: REQUIRED for this target/toolchain combination - do not "optimise" away.
#
# With CONFIG_LOG_MAXIMUM_LEVEL == CONFIG_LOG_DEFAULT_LEVEL, IDF moves every
# ESP_LOGD/ESP_LOGV format string into the .rodata_wlog_debug/.rodata_wlog_verbose
# sections. On esp32s31 with CONFIG_SPIRAM_XIP_FROM_PSRAM, the generated
# sections.ld emits those sections *after* the _rodata_reserved_end symbol, and the
# following .ext_ram.dummy section then has to move the location counter backwards:
#
#   sections.ld:1280 cannot move location counter backwards (from 5022b8f0 to 50227480)
#   collect2.exe: error: ld returned 1 exit status
#
# Raising the maximum level to VERBOSE keeps those strings in ordinary rodata so
# the link succeeds. This does NOT change runtime output: CONFIG_LOG_DEFAULT_LEVEL
# stays INFO, and the extra headroom is useful because it lets a single tag be
# raised to DEBUG at runtime via esp_log_level_set()/sys_log_set_level().
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=n
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# ToDoHelper: Chinese UI text.
#
# Primary path is FreeType rendering the CJK subset embedded by ui_core
# (components/ui_core/fonts/ui_cjk.ttf, produced by tools/gen_cjk_font.py).
# The built-in Source Han Sans SC 16 px font is kept as the safety net that
# ui_fonts.c falls back to when FreeType or the TTF is unavailable, so Chinese
# never degrades into empty boxes. The 14 px built-in is disabled because
# FreeType covers every size and the built-in costs ~1 MB of rodata.
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_FONT_DEFAULT_SOURCE_HAN_SANS_SC_16_CJK=y
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK is not set
# CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14 is not set

# FreeType: scalable text at every role (16/20/28/48 px) from one subset font.
# SMALL_RENDER_POOL keeps FreeType's render pool at 4 KB (instead of 16 KB) and
# removes LVGL's conservative 32 KB FreeType draw-stack build-time check;
# MINIMAL_BUILD drops the font drivers we never use (Type1/CID/PFR/BDF/PCF/FNT
# and the gzip/lzw/bzip2 stream helpers) to save flash.
CONFIG_LV_USE_FREETYPE=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FREETYPE=y
CONFIG_ESP_LVGL_ADAPTER_FREETYPE_SMALL_RENDER_POOL=y
CONFIG_ESP_LVGL_ADAPTER_FREETYPE_MINIMAL_BUILD=y
CONFIG_TODOHELPER_FONT_FREETYPE=y

# FreeType 字形缓存：64 → 512（v1.8.5）。
#
# 这个缓存装的是**每一个用过的（汉字, 字号）组合的位图**
# （16 px 约 256 B，28 px 约 784 B，48 px 约 2.3 KB）。
#
# 关键事实（v1.8.5 在真机上查证）：LVGL 9 的 FreeType 是按
# **（字体文件, 样式, 渲染模式）** 给缓存做 key 的，**不是按字号**——
# 四个字号共用同一份缓存。所以这个上限是**整个界面共用**的预算：
# 64 条 / 4 个字号 ≈ 每个字号只有 16 个字的位置，一屏 30~40 个汉字根本装不下，
# 于是每个新字都要重新光栅化（读 SD 卡里的 TTF + FreeType 渲染，约 10 ms 一个字（缓存只有 64 条时同一个字要 45 ms））。
#
# 真机实测（debug shell 的 bench-screen：整屏重画，也就是滚动一帧的代价；
# 同一个固件只改上限）：
#   64  → 第 1 次 728 ms，**后面每次都是 727 ms** ← v1.8.4 就是这个
#          （缓存装不下这一屏的字，每一帧都在重画同样的字）
#   512 → 第 1 次 24 ms，稳态 **23.5 ms**        ← 现在这个，快 31 倍
# 注意：切页耗时（11~222 ms）与字形缓存无关 —— A/B 实测两栏一样，慢的是重建控件。
#
# 之所以现在敢开 512，是因为位图**和缓存的元数据**都搬去了 PSRAM：
#   - 位图：LVGL 的 font_draw_buf_handlers（components/ui_core/src/ui_font_mem.c）
#   - 元数据：LVGL 换成自定义分配器（components/ui_core/src/ui_lv_mem.c），
#     只有「画字」这一个区间里的分配走 PSRAM，其余分配行为一个字没动。
#
# **不要动全局的 CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL。** 试过把它压到 128
# （让所有小分配都落 PSRAM），结果 **TLS 握手直接失败**
# （mbedtls_ssl_handshake 返回 -0x008D = 内存不足）。全局阈值一动，
# mbedTLS 握手时的小分配也被赶去 PSRAM，连续块就不够了。
#
# 实测：整个界面用到 516 个（字形, 字号）组合、415 个位图。
# 512 刚好装得下；上限可以用 NVS 键 "ft_glyph_cache" 在运行时调
# （范围 16~1024，默认值见 components/ui_core/src/ui_fonts.c；上限不是随便定的：
# 位图现在住 PSRAM，最坏情况 48 px 汉字 2.3 KB 一张，1024 张约 2.4 MB，
# 再多就会把 PSRAM 撑满 —— 那时位图分配失败，字会**静默画不出来**）。
CONFIG_LV_FREETYPE_CACHE_FT_GLYPH_CNT=512

# Display / UI
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FPS_STATS=y
# LVGL 的分配器改成我们自己写的（components/ui_core/src/ui_lv_mem.c）。
#
# 为什么要接管：字形缓存的**元数据**（红黑树节点 + 缓存条目 + draw_buf 结构）
# 每个字形约 200 B，而整个界面用到 517 个（字形, 字号）组合 —— 光元数据就
# 100 KB，内部堆一共才 290 KB，撑不住。
#
# 接管之后**平时一个字没动**（还是 malloc/realloc/free，行为与原来的
# CONFIG_LV_USE_CLIB_MALLOC 完全一致），只有「画字」这一个区间里的分配
# 走 PSRAM：那个区间由 FreeType 的两个回调（get_glyph_dsc / get_glyph_bitmap）
# 包出来，区间里分配的正好就是字形缓存的元数据。
#
# 效果（真机，页面巡游三遍之后）：内部堆最大连续块 12 KB → **80 KB**，
# 空闲 73 KB → **150 KB**。
#
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DPI_DEF=60
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=29152
# Only a handful of small PNG icons are ever cached; the 4 MB default is pure
# waste on a device with 310 KB of internal RAM.
CONFIG_LV_CACHE_DEF_SIZE=1048576
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=32
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_46=y

# Camera: not used by ToDoHelper, but the read-only Korvo BSP requires esp_video/esp_cam_sensor.
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=n
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_DVP_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_640X480_15FPS=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_1280X720_15FPS=n
CONFIG_CAMERA_SC101IOT_DVP_YUV422_DEFAULT_FMT_YUV422_640X480_15FPS=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Debug shell (development aid): text-command interface at /api/v1/debug/exec
# so the UI can be inspected and driven remotely. Off in a shipped build; see
# components/debug_shell/Kconfig. Turn OFF before shipping.
CONFIG_TODOHELPER_DEBUG_SHELL=y
